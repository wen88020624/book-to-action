generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  bookConcepts BookConcept[]
}

model Concept {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  bookConcepts       BookConcept[]
  conceptExperiments ConceptExperiment[]
}

model BookConcept {
  bookId    String
  conceptId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([bookId, conceptId])
}

model Experiment {
  id          String   @id @default(cuid())
  title       String
  description String
  problem     String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  conceptExperiments ConceptExperiment[]
  logs               ExperimentLog[]
  result             ExperimentResult?
}

model ConceptExperiment {
  conceptId    String
  experimentId String

  concept    Concept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@id([conceptId, experimentId])
}

model ExperimentLog {
  id           String     @id @default(cuid())
  experimentId String
  body         String
  loggedAt     DateTime   @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

model ExperimentResult {
  id           String   @id @default(cuid())
  experimentId String   @unique
  quantitative String?
  qualitative  String?
  reflection   String?
  rating       String?
  completedAt  DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}
